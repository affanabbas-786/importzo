// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

// Note that some adapters may set a maximum length for the String type by default, please ensure your strings are long
// enough when changing adapters.
// See https://www.prisma.io/docs/orm/reference/prisma-schema-reference#string for more information
datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Session {
  id            String    @id
  shop          String
  state         String
  isOnline      Boolean   @default(false)
  scope         String?
  expires       DateTime?
  accessToken   String
  userId        BigInt?
  firstName     String?
  lastName      String?
  email         String?
  accountOwner  Boolean   @default(false)
  locale        String?
  collaborator  Boolean?  @default(false)
  emailVerified Boolean?  @default(false)
  refreshToken        String?
  refreshTokenExpires DateTime?
}

model ImportJob {
  id           String   @id @default(uuid())
  shop         String
  fileName     String
  totalRows    Int
  successCount Int      @default(0)
  errorCount   Int      @default(0)
  status       String   @default("pending")
  results      String   @default("[]")
  importType   String   @default("products")
  createdAt    DateTime @default(now())
}

model SourceStore {
  id          String   @id @default(uuid())
  shop        String   @unique
  sourceUrl   String
  sourceName  String   @default("")
  sourceEmail String   @default("")
  sourcePlan  String   @default("")
  token       String
  lastUsed    DateTime @default(now())
  createdAt   DateTime @default(now())
}

model TransferSession {
  id           String   @id @default(cuid())
  code         String   @unique
  password     String
  sourceShop   String
  sourceToken  String
  destShop     String?
  destToken    String?
  status       String   @default("pending")
  attemptCount Int      @default(0)
  expiresAt    DateTime
  createdAt    DateTime @default(now())
}

// Tracks async background product-transfer jobs so they survive HTTP timeouts.
model MigrationJob {
  id                String   @id @default(cuid())
  shop              String   // destination shop domain
  sourceShop        String
  sourceToken       String   // AES-encrypted
  destToken         String   // AES-encrypted
  apiVersion        String   @default("2025-10")
  status            String   @default("PENDING") // PENDING | RUNNING | COMPLETED | FAILED
  totalProducts     Int      @default(0)
  processedProducts Int      @default(0)
  failedProducts    Int      @default(0)
  lastCursor        String?  // GraphQL cursor for resume
  conflictMode      String   @default("skip") // skip | overwrite | create
  errorLog          String   @default("[]")   // JSON array of {sourceId,title,error}
  // Phase 2: pre-transfer backup of the destination.
  // backupPolicy: require | best-effort | skip. "require" fails the job before
  // any write if the snapshot can't be taken, rather than silently running an
  // irreversible transfer with no way back.
  backupPolicy      String   @default("require")
  backupId          String?
  backupStatus      String? // mirrors StoreBackup.status for cheap display
  rolledBackAt      DateTime?
  // Phase 3.7 audit trail: who triggered this transfer, and from where.
  // Captured at creation time because the worker is fire-and-forget — by the
  // time it writes log entries there is no request, and therefore no IP or
  // session, to attribute them to. The worker reads these back and stamps
  // them onto every TransferLogEntry it writes.
  actorType         String   @default("unknown") // user | schedule | system | unknown
  actorId           String?
  actorEmail        String?
  actorIp           String?
  // Phase 4.2: optional Markets-scoped transfer. Resolved server-side at job
  // creation time (never trusted from the client) and snapshotted here so a
  // resumed/restarted worker doesn't need to re-fetch Markets mid-job.
  // sourceMarketPublicationIds is null when the market has no restricting
  // catalog (see markets.server.js) — every product is "in" that market, so
  // there is nothing to filter by, and the worker skips filtering entirely.
  sourceMarketId                 String?
  sourceMarketHandle             String?
  sourceMarketPublicationIds     String? // JSON array of publication GIDs, or null
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

// Idempotency map: prevents re-creating products that already succeeded on resume.
model ProductMapping {
  id              String  @id @default(cuid())
  jobId           String
  sourceProductId String
  destProductId   String?
  status          String  // DONE | FAILED
  error           String?
  // Phase 2 (rollback safety): what this transfer actually DID to the
  // destination product. Rollback may only delete rows it can prove this app
  // created — a "skipped" row points at the merchant's own pre-existing
  // product. Defaults to "unknown" so rows written before this column existed
  // are never assumed safe to delete.
  action          String  @default("unknown") // created | updated | skipped | unknown

  @@unique([jobId, sourceProductId])
  @@index([jobId])
  @@index([jobId, action])
}

// ─────────────────────────────────────────────────────────────────────────────
// Phase 2 — Trust & Safety
// ─────────────────────────────────────────────────────────────────────────────

// Recurring sync configuration. Tokens are AES-encrypted at rest, same as
// MigrationJob's. consecutiveFailures exists so a schedule that can no longer
// authenticate (offline tokens expire — see expiringOfflineAccessTokens in
// shopify.server.js) disables itself instead of retrying forever.
model ScheduledSync {
  id                 String    @id @default(cuid())
  shop               String // destination shop
  sourceShop         String
  sourceToken        String // AES-encrypted
  destToken          String // AES-encrypted
  frequency          String    @default("daily") // hourly | daily | weekly
  hourUtc            Int       @default(3)
  dayOfWeek          Int? // 0-6 (Sun-Sat), weekly only
  conflictMode       String    @default("skip")
  enabled            Boolean   @default(true)
  nextRunAt          DateTime
  lastRunAt          DateTime?
  lastJobId          String?
  lastError          String?
  consecutiveFailures Int      @default(0)
  disabledReason     String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  @@index([enabled, nextRunAt])
  @@index([shop])
}

// Pre-transfer snapshot of the DESTINATION store, taken before any write, so
// a transfer can be undone. Payload is JSON in `data`; `truncated` records
// whether the store exceeded the snapshot cap, because a merchant must never
// believe they have a complete backup when they don't.
model StoreBackup {
  id              String    @id @default(cuid())
  shop            String // destination shop that was snapshotted
  jobId           String? // the MigrationJob this backup was taken for
  status          String    @default("PENDING") // PENDING | READY | FAILED | RESTORED | PARTIAL
  productCount    Int       @default(0)
  collectionCount Int       @default(0)
  metafieldCount  Int       @default(0)
  truncated       Boolean   @default(false)
  data            String    @default("{}") // JSON snapshot payload
  sizeBytes       Int       @default(0)
  error           String?
  createdAt       DateTime  @default(now())
  expiresAt       DateTime
  restoredAt      DateTime?

  @@index([shop])
  @@index([jobId])
  @@index([shop, createdAt])
}

// Granular per-record transfer log covering EVERY entity type, not just
// products (ProductMapping only tracks products, and only as DONE|FAILED).
// MigrationJob.errorLog stays as the small capped summary surfaced in the
// polling API; this table is the full, queryable, per-record history.
model TransferLogEntry {
  id         String   @id @default(cuid())
  jobId      String
  shop       String
  entityType String // product | collection | page | blog | article | menu | file | theme | metafield
  action     String // created | updated | skipped | failed
  sourceId   String?
  destId     String?
  title      String?
  reason     String? // why it was skipped, or the failure message
  detail     String? // JSON: payload snapshot / warnings, truncated
  // Phase 3.7 audit trail: who caused this record to change, and from where.
  // `createdAt` is the "when". actorEmail is personal data, so this table is
  // covered by shop/redact erasure (see shop-data.server.js).
  actorType  String   @default("unknown") // user | schedule | system | unknown
  actorId    String? // Shopify staff user id, when the session exposes one
  actorEmail String?
  actorIp    String?
  createdAt  DateTime @default(now())

  @@index([jobId])
  @@index([jobId, action])
  @@index([jobId, entityType])
}

// ─────────────────────────────────────────────────────────────────────────────
// Phase 4 — Differentiation
// ─────────────────────────────────────────────────────────────────────────────

// A merchant-saved CSV column → Shopify field mapping, reusable across repeat
// imports so a recurring supplier feed doesn't need re-mapping every time.
// `mapping` is keyed by CSV HEADER TEXT (not column index), since index would
// silently misapply if a future file reorders columns — see
// smart-mapper.js's applyMappingTemplate/templateFromMapping.
model FieldMappingTemplate {
  id         String   @id @default(cuid())
  shop       String
  name       String
  importType String   // products | collections | inventory | woocommerce
  mapping    String   // JSON: { [csvHeaderText]: shopifyField }
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([shop, importType, name])
  @@index([shop, importType])
}
