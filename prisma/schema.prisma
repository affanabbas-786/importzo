// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

// Note that some adapters may set a maximum length for the String type by default, please ensure your strings are long
// enough when changing adapters.
// See https://www.prisma.io/docs/orm/reference/prisma-schema-reference#string for more information
datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Session {
  id            String    @id
  shop          String
  state         String
  isOnline      Boolean   @default(false)
  scope         String?
  expires       DateTime?
  accessToken   String
  userId        BigInt?
  firstName     String?
  lastName      String?
  email         String?
  accountOwner  Boolean   @default(false)
  locale        String?
  collaborator  Boolean?  @default(false)
  emailVerified Boolean?  @default(false)
  refreshToken        String?
  refreshTokenExpires DateTime?
}

model ImportJob {
  id           String   @id @default(uuid())
  shop         String
  fileName     String
  totalRows    Int
  successCount Int      @default(0)
  errorCount   Int      @default(0)
  status       String   @default("pending")
  results      String   @default("[]")
  importType   String   @default("products")
  createdAt    DateTime @default(now())
}

model SourceStore {
  id          String   @id @default(uuid())
  shop        String   @unique
  sourceUrl   String
  sourceName  String   @default("")
  sourceEmail String   @default("")
  sourcePlan  String   @default("")
  token       String
  lastUsed    DateTime @default(now())
  createdAt   DateTime @default(now())
}

model TransferSession {
  id           String   @id @default(cuid())
  code         String   @unique
  password     String
  sourceShop   String
  sourceToken  String
  destShop     String?
  destToken    String?
  status       String   @default("pending")
  attemptCount Int      @default(0)
  expiresAt    DateTime
  createdAt    DateTime @default(now())
}

// Tracks async background product-transfer jobs so they survive HTTP timeouts.
model MigrationJob {
  id                String   @id @default(cuid())
  shop              String   // destination shop domain
  sourceShop        String
  sourceToken       String   // AES-encrypted
  destToken         String   // AES-encrypted
  apiVersion        String   @default("2025-10")
  status            String   @default("PENDING") // PENDING | RUNNING | COMPLETED | FAILED
  totalProducts     Int      @default(0)
  processedProducts Int      @default(0)
  failedProducts    Int      @default(0)
  lastCursor        String?  // GraphQL cursor for resume
  conflictMode      String   @default("skip") // skip | overwrite | create
  errorLog          String   @default("[]")   // JSON array of {sourceId,title,error}
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

// Idempotency map: prevents re-creating products that already succeeded on resume.
model ProductMapping {
  id              String  @id @default(cuid())
  jobId           String
  sourceProductId String
  destProductId   String?
  status          String  // DONE | FAILED
  error           String?

  @@unique([jobId, sourceProductId])
  @@index([jobId])
}
