# Local development environment — template.
#
# Copy this to `.env` ON YOUR DEV MACHINE ONLY:
#     cp .env.development.example .env
#
# NEVER copy the server's .env down to a dev machine. The server's file carries
# NODE_ENV=production, and app/routes/app.billing.jsx's isTestCharge() keys off
# NODE_ENV alone — in production mode a "Subscribe" click on the Billing page
# requests a REAL recurring charge from Shopify instead of a test one.
#
# Three independent layers now keep the two apart:
#   1. package.json "dev" and shopify.web.toml's dev command both pin
#      NODE_ENV=development, overriding whatever .env says.
#   2. ecosystem.importzo.config.cjs pins NODE_ENV=production for PM2,
#      independent of the server's .env.
#   3. app/shopify.server.js refuses to boot on NODE_ENV=production served
#      from localhost or a dev tunnel.

NODE_ENV=development

# From the Partners Dashboard app you develop against. Use a DEVELOPMENT app
# and a development store — not the production app's credentials.
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
# Must match shopify.app.toml's scopes line exactly — shopify.server.js
# configures the app from SCOPES, not from the toml, so a narrower value
# here silently changes what a dev run requests. Guarded by test/scopes.test.js.
SCOPES=read_products,write_products,read_inventory,write_inventory,read_themes,write_themes,read_files,write_files,read_content,write_content,read_online_store_pages,read_legal_policies,read_online_store_navigation,write_online_store_navigation,read_customers,read_markets

# Left blank on purpose: `shopify app dev` injects the tunnel URL at runtime.
SHOPIFY_APP_URL=

# Local SQLite file — never point this at production.sqlite.
DATABASE_URL=file:./dev.sqlite

PORT=3000

# Generate throwaway local values, e.g.:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=
ENCRYPTION_KEY=
SCHEDULER_SECRET=

# Optional — AI features. Leave blank to run without them.
GROQ_API_KEY=
