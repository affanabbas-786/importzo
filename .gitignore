# SQLite sidecar files for the local dev database (WAL mode is enabled in
# db.server.js, so these two always exist alongside it).
/prisma/dev.sqlite-shm
/prisma/dev.sqlite-wal

# Guard against a nested dev database reappearing. Prisma resolves relative
# sqlite paths from the SCHEMA directory (prisma/), not the project root, so a
# DATABASE_URL of "file:./prisma/dev.sqlite" silently lands at
# prisma/prisma/dev.sqlite. That happened, and the resulting database held real
# OAuth tokens while being ignored by nothing. DATABASE_URL now reads
# "file:./dev.sqlite"; this rule stays so a regression cannot commit tokens.
prisma/prisma/
